{
  "name": "template-dms-connect-demo",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "ajs project run -w",
    "frontend:dev": "ajs dms dev",
    "suppressions": "antelopejs-suppressions",
    "suppressions:update": "antelopejs-suppressions --update",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix && oxfmt .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "knip": "knip --workspace . --dependencies",
    "test": "pnpm run build && node --test \"dist/**/*.test.js\"",
    "size": "antelopejs-check-size",
    "checks": "antelopejs-checks",
    "sync": "antelopejs-sync --profile template",
    "sync:check": "antelopejs-sync --check --profile template"
  },
  "dependencies": {
    "@antelopejs/interface-api": ">=0.3.0 <1.0.0",
    "@antelopejs/interface-core": ">=0.4.0 <1.0.0",
    "@antelopejs/interface-data-api": ">=0.6.1 <1.0.0",
    "@antelopejs/interface-database": ">=0.3.1 <1.0.0",
    "@antelopejs/interface-database-decorators": ">=0.2.1 <1.0.0",
    "@antelopejs/interface-dms": ">=0.12.0 <1.0.0",
    "@openai/codex": "0.154.0"
  },
  "devDependencies": {
    "@antelopejs/core": "1.21.0",
    "@antelopejs/dms-frontend": "0.10.0",
    "@antelopejs/tooling-configs": "^0.3.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/rethinkdb": "^2.3.21",
    "knip": "^6",
    "mongodb": "6.21.0",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2006",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.2.0",
  "antelopeJs": {
    "baseUrl": "dist",
    "paths": {
      "@/*": [
        "*"
      ]
    }
  }
}
