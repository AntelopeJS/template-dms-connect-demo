{
  "name": "template-dms-connect-demo",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "ajs project run -w",
    "frontend:dev": "ajs dms dev",
    "suppressions": "antelopejs-suppressions",
    "suppressions:update": "antelopejs-suppressions --update",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix && oxfmt .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "knip": "knip --workspace . --dependencies",
    "test": "pnpm run build && node --test \"dist/**/*.test.js\"",
    "size": "antelopejs-check-size",
    "checks": "antelopejs-checks",
    "sync": "antelopejs-sync --profile template",
    "sync:check": "antelopejs-sync --check --profile template"
  },
  "dependencies": {
    "@antelopejs/interface-api": ">=0.3.4 <0.4.0",
    "@antelopejs/interface-api-util": ">=0.3.3 <0.4.0",
    "@antelopejs/interface-core": ">=0.5.2 <0.6.0",
    "@antelopejs/interface-data-api": ">=0.8.2 <0.9.0",
    "@antelopejs/interface-database": ">=0.4.3 <0.5.0",
    "@antelopejs/interface-database-decorators": ">=0.5.4 <0.6.0",
    "@antelopejs/interface-dms": "^0.17.0",
    "@antelopejs/interface-file-storage": ">=0.1.9 <0.2.0",
    "@antelopejs/mongodb": ">=1.8.13 <1.9.0",
    "@antelopejs/mysql": ">=0.2.8 <0.3.0",
    "@antelopejs/postgres": ">=0.4.4 <0.5.0",
    "@antelopejs/rethinkdb": "~1.10.7",
    "@openai/codex": "0.166.0"
  },
  "devDependencies": {
    "@antelopejs/core": "~1.24.7",
    "@antelopejs/dms-frontend": "^0.11.10",
    "@antelopejs/tooling-configs": "^0.10.4",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/rethinkdb": "^2.3.21",
    "knip": "^6.46.1",
    "mongodb": "6.22.0",
    "mysql2": "^3.24.6",
    "oxfmt": "^0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "rimraf": "^6.1.4",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.33.0",
  "antelopeJs": {
    "baseUrl": "dist",
    "paths": {
      "@/*": [
        "*"
      ]
    }
  }
}
